# --- Squeeze the Line frontend environment ---
# Copy to frontend/.env.local for local dev, or set in the Vercel dashboard.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
# In production set this to your deployed backend URL, e.g.
#   https://squeeze-the-line-api.onrender.com
# Must be prefixed NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase auth (optional) ---
# From Supabase Dashboard → Project Settings → API. When unset, the app hides
# all auth features (sign in, Save Pick, My Picks) and works as a public board.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
