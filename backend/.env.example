# --- Squeeze the Line backend environment ---
# Copy to backend/.env for local dev (loaded automatically by backend/main.py
# via python-dotenv), or set these as service env vars on Railway/Render.

# REQUIRED for live data. The Odds API key (https://the-odds-api.com).
# Without it the backend still starts but serves deterministic MOCK data
# (see backend/providers/__init__.py -> get_provider).
ODDS_API_KEY=

# --- Supabase auth + user data ---
# Required for the user-specific endpoints (/api/picks/*, /api/alerts). When
# unset, those endpoints respond with 503 and the public projection endpoints
# still work, so the app degrades gracefully.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — used by the API for server-side reads/writes to the
# saved_picks / pick_results / alerts tables. Keep secret; never expose to the
# frontend.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret (Supabase dashboard → Project Settings → API → JWT Secret). Used
# to verify the access tokens the frontend sends in the Authorization header.
SUPABASE_JWT_SECRET=
