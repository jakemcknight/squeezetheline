# --- Squeeze the Line backend environment ---
# Copy to backend/.env for local dev (loaded automatically by backend/main.py
# via python-dotenv), or set these as service env vars on Railway/Render.

# REQUIRED for live data. The Odds API key (https://the-odds-api.com).
# Without it the backend still starts but serves deterministic MOCK data
# (see backend/providers/__init__.py -> get_provider).
ODDS_API_KEY=

# --- Optional: Supabase (used by the legacy auth/picks/digest modules at the
# repo root). The FastAPI projection endpoints do NOT require these; set them
# only if you wire Supabase-backed features into the API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — only needed for server-side writes (auto_runner.py). Keep
# secret; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
